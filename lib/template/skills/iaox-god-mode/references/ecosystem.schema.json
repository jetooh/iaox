{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IAOX Ecosystem Registry",
  "type": "object",
  "required": ["name", "apps"],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "stack", "status"],
        "properties": {
          "name": { "type": "string" },
          "stack": { "type": "string" },
          "port": { "type": ["integer", "null"] },
          "status": { "type": "string", "enum": ["active", "wip", "archived"] },
          "description": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    }
  }
}
