{
  "name": "iaox-ecosystem",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Monorepo do ecossistema IAOX — apps em app/*, código compartilhado em packages/*.",
  "workspaces": [
    "app/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "knip": "knip",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{js,cjs,mjs,json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "knip": "^5.33.3",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript-eslint": "^8.11.0"
  },
  "packageManager": "npm@10.0.0"
}
