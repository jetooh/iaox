{
  "name": "iaox-ecosystem",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Monorepo do ecossistema IAOX — apps em app/*, código compartilhado em packages/*.",
  "workspaces": [
    "app/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "knip": "turbo run knip"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript-eslint": "^8.11.0"
  },
  "packageManager": "npm@10.0.0"
}
